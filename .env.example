NODE_ENV=development
PORT=3001
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=pc_kumba_mbeng
DB_USER=your-database-user
DB_PASSWORD=
DB_CONNECTION_LIMIT=2
# Enable if supported by your MySQL provider; certificate verification stays on.
DB_SSL=false
# Optional PEM CA certificate (use literal \n for line breaks).
DB_SSL_CA=
# Generate a unique random secret of at least 32 characters for each environment.
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
# Connect a public Vercel Blob store to the BACKEND project.
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE_URL=https://your-store.public.blob.vercel-storage.com
UPLOAD_DIR=./uploads
MAX_ATTACHMENT_SIZE_MB=10
MAX_AUDIO_SIZE_MB=100
# Optional push notifications: same public key goes in the frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@pckumbambeng.org
# Optional legacy Facebook polling only; embeds need no tokens or cron job.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
CRON_SECRET=
