# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pc_kumba_mbeng

# JWT Configuration
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=30m

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Fapshi Payment Gateway
FAPSHI_API_USER=
FAPSHI_API_KEY=
FAPSHI_BASE_URL=https://live.fapshi.com
FAPSHI_REDIRECT_URL=http://localhost:3000/payments/callback

# Facebook Graph API
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Web Push (VAPID Keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@pckumbambeng.org

# File Upload
UPLOAD_DIR=./uploads
MAX_AUDIO_SIZE_MB=100
MAX_ATTACHMENT_SIZE_MB=10
